# The website, built by fuguweb(1).

site = FuguSeed

nav "index.html" {
	label = Home
}

nav "manuals.html" {
	label = Manuals
}

page "index.html" {
	title = Home
	body  = index.body.html
}

page "manuals.html" {
	title = Manuals
	index = yes
	body  = manuals.body.html
}

page "404.html" {
	title    = Not found
	body     = 404.body.html
	unlinked = yes
}

manuals procedure {
	heading = The offline procedure
	dir     = man/fuguseed
}

manuals words {
	heading = The word sheet
	dir     = man/fuguseed-words
}

manuals last {
	heading = The check word
	dir     = man/fuguseed-last
}

manuals qr {
	heading = The SeedQR
	dir     = man/fuguseed-qr
}

modules modules {
	heading = Modules
	dir     = lib/App/FuguSeed
}
