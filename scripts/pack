# pack: write the packed fuguseed-last and fuguseed-qr files
# (LAST-PACK, QR-PACK).
#
# usage: pack [--version X.Y.Z] [--out DIR]
#
# The script takes the two options of scripts/dist. --out names the
# output directory, and build is its default. It runs scripts/dist
# with the same two values, and it packs the tarball that the build
# writes. The build derives the version from the latest tag when the
# value is empty, so no second copy of the tag logic exists here. The
# tarball holds the modules with the $VERSION of the tag, so each
# packed file names its version.
#
# The script reads the tarball path from "Built <path>", the last
# line of the build. It extracts the tarball under the output
# directory, it packs from the extracted tree, and it removes the
# tree.
#
# One build feeds the two packed files. Each file holds its header,
# the modules of its program, in dependency order, and the program
# body last. Before each module the script writes a BEGIN block that
# marks the module as loaded, so a use line of a later module opens
# no file. A block around each module keeps the package and the file
# variables of one module apart from the next. A file holds no
# timestamp and no path, so two packs of one tree are byte-equal
# (QR-PACK-3).
#
# The script is a bootstrap script of this repository: core modules
# only. It runs scripts/dist with the perl that runs it, and that
# perl must be v5.36 or later.

use v5.34;
use warnings;
use experimental 'signatures';
no feature qw(indirect multidimensional bareword_filehandles);

use File::Path   qw(make_path remove_tree);
use File::Spec   ();
use Getopt::Long qw(GetOptions);

# DIST:
#	The build script. It reads .toolingrc of the working
#	directory, so pack runs at the repository root, as make dist
#	does.
use constant DIST => 'scripts/dist';

# HEADER_LAST and HEADER_QR:
#	The first lines of each packed file. The shebang is the base
#	perl: the air-gapped computer runs the perl that it has, and
#	it installs nothing (D-07).
use constant HEADER_LAST => <<'HEADER';
#!/usr/bin/perl
# fuguseed-last: print the check word of 11 seed words and two dice.
#
# scripts/pack of FuguSeed writes this file from the modules of that
# repository, and the release publishes it beside the tarballs. Do
# not edit this file. Edit the modules, and pack them again.
#
# The file holds the program and the three modules that it loads.
# Each module keeps its source, under a BEGIN block that marks the
# module as loaded. The file loads Digest::SHA and the pragmas of its
# source, and no other module. Every perl since 5.34 holds each one.
#
# The file opens no file, it starts no process, and it reads no
# environment variable. The three standard streams are its one
# contact with the computer. Words 1 to 11 and the YELLOW and BLUE
# faces of word 12 enter on standard input. The check word leaves on
# standard output, and no other word or face leaves on any channel.

HEADER

use constant HEADER_QR => <<'HEADER';
#!/usr/bin/perl
# fuguseed-qr: print a Standard SeedQR as text, zone by zone.
#
# scripts/pack of FuguSeed writes this file from the modules of that
# repository, and the release publishes it beside the tarballs. Do
# not edit this file. Edit the modules, and pack them again.
#
# The file holds the program and the six modules that it loads. Each
# module keeps its source, under a BEGIN block that marks the module
# as loaded. The file loads Digest::SHA and the pragmas of its
# source, and no other module. Every perl since 5.34 holds each one.
#
# The file opens no file, it starts no process, and it reads no
# environment variable. The three standard streams are its one
# contact with the computer. The 12 seed words enter on standard
# input, and they leave on no channel.

HEADER

# PACKS:
#	One row for each packed file: the name of the file, the
#	program body in the tarball, the header, and the modules of
#	the program in dependency order (LAST-PROGRAM-6, QR-PROGRAM-6,
#	LIST-MODULE-1). The script packs these modules and no other
#	module (QR-PACK-2). release.yml names each file as an asset of
#	the release (SEC-RELEASE-1).
use constant PACKS => [ {
		output  => 'fuguseed-last',
		program => 'bin/fuguseed-last',
		header  => HEADER_LAST,
		modules => [
			'App/FuguSeed/List.pm', 'App/FuguSeed/Mnemonic.pm',
			'App/FuguSeed/Last.pm',
		],
	},
	{
		output  => 'fuguseed-qr',
		program => 'bin/fuguseed-qr',
		header  => HEADER_QR,
		modules => [
			'App/FuguSeed/List.pm',
			'App/FuguSeed/Mnemonic.pm',
			'App/FuguSeed/Codewords.pm',
			'App/FuguSeed/Matrix.pm',
			'App/FuguSeed/Text.pm',
			'App/FuguSeed/QR.pm',
		],
	},
];

my $version = q{};
my $out     = 'build';

GetOptions(
	'version=s' => \$version,
	'out=s'     => \$out,
) or die "usage: pack [--version X.Y.Z] [--out DIR]\n";

# _status($status):
#	The report of a child status: the reason that the child did
#	not run, the signal that killed it, or its exit code. system
#	and $? both answer -1 when no child ran, and -1 >> 8 names no
#	exit code.
sub _status ($status)
{
	return "did not run: $!"                     if $status == -1;
	return 'died on signal ' . ( $status & 127 ) if $status & 127;

	return 'exited ' . ( $status >> 8 );
}

# _read($path):
#	The whole file as text.
sub _read ($path)
{
	open my $fh, '<', $path or die "pack: read $path: $!\n";
	local $/ = undef;
	my $text = <$fh>;
	close $fh or die "pack: close $path: $!\n";

	return $text;
}

# _build($version, $out):
#	Run the build with the two values, and give the path of the
#	tarball that it writes. The build reports each line that it
#	writes, so make dist names the tarball as well as the packed
#	file. The report prints before the close: a failed build is
#	the run that needs its report most.
sub _build ( $version, $out )
{
	open my $ph, '-|', $^X, DIST, '--version', $version, '--out', $out
	    or die 'pack: cannot run ' . DIST . ": $!\n";
	my @line = <$ph>;

	print @line or die "pack: cannot report the build: $!\n";
	close $ph
	    or die 'pack: ' . DIST . q{ } . _status($?) . "\n";

	chomp @line;

	my $built = @line ? $line[-1] : q{};
	$built =~ /^Built[ ](.+)\z/a
	    or die 'pack: ' . DIST . " named no tarball\n";

	return $1;
}

# _extract($tarball, $temp):
#	Extract $tarball under the directory $temp, and give the path
#	of the tree that it holds.
sub _extract ( $tarball, $temp )
{
	remove_tree($temp);
	make_path($temp);
	-d $temp or die "pack: cannot make $temp\n";

	my $status = system 'tar', '-xzf', $tarball, '-C', $temp;
	$status == 0
	    or die 'pack: tar ' . _status($status) . "\n";

	my ($name) = $tarball =~ m{([^/]+)[.]tar[.]gz\z}a
	    or die "pack: '$tarball' is no tarball\n";
	my $tree = File::Spec->catdir( $temp, $name );
	-d $tree or die "pack: the tarball holds no $name\n";

	return $tree;
}

# _write($file, $tree, $pack):
#	Write the packed file of the row $pack of PACKS from the
#	extracted tree $tree. The program body comes last, under
#	package main, without the shebang of the source: the packed
#	file holds its own.
sub _write ( $file, $tree, $pack )
{
	open my $fh, '>', $file or die "pack: write $file: $!\n";
	print {$fh} $pack->{header} or die "pack: write $file: $!\n";

	for my $module ( @{ $pack->{modules} } ) {
		my $source =
		    _read( File::Spec->catfile( $tree, 'lib', $module ) );
		print {$fh} "BEGIN { \$INC{'$module'} = __FILE__; }\n",
		    "{\n", $source, "}\n\n"
		    or die "pack: write $file: $!\n";
	}

	my $body = _read( File::Spec->catfile( $tree, $pack->{program} ) );
	$body =~ s/\A\#![^\n]*\n//;
	print {$fh} "package main;\n\n", $body
	    or die "pack: write $file: $!\n";

	close $fh or die "pack: close $file: $!\n";
	chmod 0755, $file or die "pack: chmod $file: $!\n";

	return;
}

# The build holds use v5.36, and _build runs it with the perl that
# runs this script. This script keeps use v5.34, because a bootstrap
# script of FuguBSD takes the floor of the workspace, so the check
# belongs here.
$] >= 5.036
    or die 'pack: ' . DIST . " needs perl v5.36 or later\n";

my $tarball = _build( $version, $out );
my $temp    = File::Spec->catdir( $out, 'pack' );
my $tree    = _extract( $tarball, $temp );

for my $pack ( @{ +PACKS } ) {
	my $file = File::Spec->catfile( $out, $pack->{output} );
	_write( $file, $tree, $pack );
	say "Packed $file";
}
remove_tree($temp);
